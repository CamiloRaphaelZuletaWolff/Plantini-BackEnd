
# https://aistudio.google.com/apikey
GEMINI_API_KEY=here-your-api-key

PORT=3000
API_URL=http://localhost:3000

# Supabase — get these from https://supabase.com/dashboard/project/<id>/settings/api
SUPABASE_URL=https://your-project.supabase.co
# ⚠️  service_role key — NEVER expose to the frontend
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Expo web (4000), Metro (8081), legacy web (19006)
CORS_ORIGINS=http://localhost:4000,http://localhost:8081,http://localhost:19006

